import bisect
on_points = [d for i, d in enumerate(dist) if systemState[i]==1]
total = 0
n = len(systemState)
i = 0
while i < n:
    if systemState[i] == 0:
        start = i
        while i < n and systemState[i]==0:
            i += 1
        end = i - 1
        internal = dist[end] - dist[start]
        left_d = dist[start]
        pos = bisect.bisect_left(on_points, left_d)
        min_conn = float('inf')
        if pos < len(on_points):
            min_conn = min(min_conn, abs(on_points[pos] - left_d), abs(on_points[pos] - dist[end]))
        if pos > 0:
            min_conn = min(min_conn, abs(on_points[pos-1] - left_d), abs(on_points[pos-1] - dist[end]))
        total += internal + min_conn
    else:
        i += 1
return total


